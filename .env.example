# Copy to .env (docker compose reads it automatically). All keys are OPTIONAL:
# without them the system runs end-to-end in mock mode on the bundled corpus.

# LLM key for live classification/extraction (mock provider used if neither
# is set). Gemini free-tier keys work: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# SuperDocs agent API key for rendering the register to styled .docx/.pdf
# (rendering is skipped with a logged decision if absent)
SUPERDOCS_API_KEY=

# Force a provider: auto | anthropic | mock  (auto = anthropic if key present)
LLM_PROVIDER=auto
